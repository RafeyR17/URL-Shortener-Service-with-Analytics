PROJECT_NAME="Modern URL Shortener"
SECRET_KEY="your-secret-key-here-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
# For SQLite local dev: sqlite+aiosqlite:///./test.db
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/dbname
DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/url_shortener"

# Redis
REDIS_URL="redis://redis:6379/0"

# Domain
BASE_URL="http://localhost:8000"
